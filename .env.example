PORT=5000
NODE_ENV=development
DATABASE_URL=
# Comma-separated exact browser origins. No wildcard or trailing slash.
FRONTEND_URLS=http://localhost:3000,https://storeopsfrontend.vercel.app
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=storeops_token
CRON_SECRET=

# Resend Email Configuration
RESEND_API_KEY=
EMAIL_FROM="StoreOps <noreply@storeops.thisismahdihasan.com>"
FRONTEND_INVITE_URL=http://localhost:3000/invite

# Cloudinary Configuration (Review Screenshots)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Etsy Open API (both values are required together when configured)
ETSY_API_KEYSTRING=
ETSY_API_SHARED_SECRET=
