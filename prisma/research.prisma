model ResearchItem {
  id                String         @id @default(cuid())
  workspaceId       String
  etsyListingId     String
  originalUrl       String
  normalizedUrl     String
  title             String?
  referenceImageUrl      String?
  referenceImagePublicId String?
  createdById            String
  status            ResearchStatus @default(RESEARCHED)
  correctionRequestedAt DateTime?
  reviewSubmittedAt     DateTime?
  issueReportedAt       DateTime?
  readyForListingAt     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  designAssignments  DesignAssignment[]
  issueReports       IssueReport[]
  reviewSubmissions  ReviewSubmission[]
  finalAssets        FinalAsset[]
  listingAssignments ListingAssignment[]
  listingResult      ListingResult?
  notifications      Notification[]

  @@unique([workspaceId, etsyListingId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}
