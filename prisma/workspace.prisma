model Workspace {
  id                            String   @id @default(cuid())
  name                          String
  ownerId                       String   @unique
  designerAutoAssignmentEnabled Boolean  @default(true)
  listerAutoAssignmentEnabled   Boolean  @default(true)
  finalAssetAutoCleanupEnabled  Boolean  @default(false)
  finalAssetRetentionDays       Int      @default(30)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  owner         User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members       WorkspaceMember[]
  invites       WorkspaceInvite[]
  researchItems ResearchItem[]
  notifications Notification[]
}

model WorkspaceMember {
  id                            String          @id @default(cuid())
  workspaceId                   String
  userId                        String
  roles                         WorkspaceRole[]
  designerAssignmentEnabled     Boolean         @default(true)
  designerAssignmentPausedUntil DateTime?
  listerAssignmentEnabled       Boolean         @default(true)
  listerAssignmentPausedUntil   DateTime?
  createdAt                     DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}
